# Example Environment Variables (Template)
# DO NOT place actual secrets in this file.

# PFP runtime variables
PFP_LOG_LEVEL=INFO
PFP_ENV=development

# Infrastructure and External Connectors
# Example: S3 / AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy_access_key
AWS_SECRET_ACCESS_KEY=dummy_secret_key

# Example: SFTP / Remote storage
SFTP_HOST=sftp.example.com
SFTP_USER=dummy_user
SFTP_KEY_PATH=/path/to/dummy_key.pem

# Example: HTTP/API Auth
HTTP_AUTH_TOKEN=dummy_token
HTTP_API_URL=https://api.example.com/v1/

# Tracing and Metrics
PROMETHEUS_MULTIPROC_DIR=/tmp/pfp_metrics
